# Server
# Render provides PORT automatically; the application defaults to 3000 when
# PORT is not set. Do not hardcode a production port in source.
PORT=3000

# Database
# Inside Docker Compose, use the `postgres` service name as the host.
# For production, set DATABASE_URL to the Neon pooled connection string
# (the host containing `-pooler`) and include `sslmode=require`.
DATABASE_URL=postgresql://finance_user:finance_password@postgres:5432/finance_db

# Optional: direct (non-pooled) Neon connection string. When present, Prisma
# migrations use this URL while runtime queries continue to use DATABASE_URL.
# DIRECT_URL=postgresql://finance_user:finance_password@ep-xxx.eu-central-1.aws.neon.tech/finance_db?sslmode=require

# Authentication
# Generate two different long random values for local development.
# See Docs/DEVELOPMENT.md for example generation commands.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT lifetimes use the `jose` duration format (for example 15m and 7d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
# Comma-separated browser origins allowed to call the API. When unset, all
# origins are allowed. Set this in production to the deployed frontend origin,
# for example https://your-app.vercel.app. Add preview origins as needed.
# CORS_ORIGIN=https://your-app.vercel.app
