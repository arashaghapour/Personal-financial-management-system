# Server
PORT=3000

# Database
# Inside Docker Compose, use the `postgres` service name as the host.
DATABASE_URL=postgresql://finance_user:finance_password@postgres:5432/finance_db

# Authentication
# Generate two different long random values for local development.
# See Docs/DEVELOPMENT.md for example generation commands.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT lifetimes use the `jose` duration format (for example 15m and 7d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
