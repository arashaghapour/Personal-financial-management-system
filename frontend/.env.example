# Browser-facing API base URL. In development leave this as /api so Vite
# proxies requests to the backend without cross-origin/CORS issues.
# Frontend environment variables are bundled into the client, so they must
# never contain secrets.
VITE_API_BASE_URL=/api

# Optional Vite dev proxy target. Defaults to http://backend:3000 inside
# Docker Compose and http://localhost:3000 for a host-run dev server.
# VITE_API_PROXY_TARGET=http://localhost:3000